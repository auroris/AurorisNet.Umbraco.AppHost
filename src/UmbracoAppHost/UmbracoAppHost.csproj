<Project Sdk="Microsoft.NET.Sdk.Razor">

  <Import Project="../../Migrations/Install.props" />
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <AddRazorSupportForMvc>true</AddRazorSupportForMvc>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>UmbracoAppHost</RootNamespace>
    <RazorCompileOnBuild>false</RazorCompileOnBuild>
    <RazorCompileOnPublish>false</RazorCompileOnPublish>
    <GenerateEmbeddedFilesManifest>true</GenerateEmbeddedFilesManifest>
    <!-- Let MSBuild check browser sources and dependencies outside the VS solution. -->
    <DisableFastUpToDateCheck>true</DisableFastUpToDateCheck>
    <AppBlocksRoot Condition="'$(AppBlocksRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\AurorisNet.Umbraco.AppBlocks</AppBlocksRoot>
    <!-- AppBlocks builds from the sibling checkout until its packages are on nuget.org. Then set UseAppBlocksSource to
         false here. The CI and Release workflows already set it to false, with the other Use...Source switches. -->
    <UseAppBlocksSource Condition="'$(UseAppBlocksSource)' == ''">true</UseAppBlocksSource>
    <!-- Break-glass access builds from the sibling checkout until its package is on nuget.org. Then set
         UseBreakGlassSource to false here and set its version in Directory.Packages.props. -->
    <BreakGlassRoot Condition="'$(BreakGlassRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\AurorisNet.Umbraco.BreakGlass</BreakGlassRoot>
    <UseBreakGlassSource Condition="'$(UseBreakGlassSource)' == ''">true</UseBreakGlassSource>
    <!-- Single sign-on builds from the sibling checkout until its package is on nuget.org. Then set
         UseIdentityServerSsoSource to false here and set its version in Directory.Packages.props. -->
    <IdentityServerSsoRoot Condition="'$(IdentityServerSsoRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\AurorisNet.Umbraco.IdentityServer.SSO</IdentityServerSsoRoot>
    <UseIdentityServerSsoSource Condition="'$(UseIdentityServerSsoSource)' == ''">true</UseIdentityServerSsoSource>
    <!-- Add from directory builds from the sibling checkout until its package is on nuget.org. Then set
         UseIdentityServerDirectorySource to false here and set its version in Directory.Packages.props. -->
    <IdentityServerDirectoryRoot Condition="'$(IdentityServerDirectoryRoot)' == ''">$(MSBuildThisFileDirectory)..\..\..\AurorisNet.Umbraco.IdentityServer.Directory</IdentityServerDirectoryRoot>
    <UseIdentityServerDirectorySource Condition="'$(UseIdentityServerDirectorySource)' == ''">true</UseIdentityServerDirectorySource>
    <!-- App_Plugins and the login images must sit at the site root, not under /_content/UmbracoAppHost/. -->
    <StaticWebAssetBasePath>/</StaticWebAssetBasePath>
    <PackageId>AurorisNet.Umbraco.AppHost</PackageId>
    <Title>Umbraco App Host</Title>
    <Description>A shared base for Umbraco sites: single sign-on and account policy, application blocks and Interactive Reports, website and application themes, virtual-path hosting, and the workarounds for upstream Umbraco gaps.</Description>
    <PackageIcon>icon.png</PackageIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- The implicit usings of the Web SDK, which this code was written against. -->
    <Using Include="Microsoft.AspNetCore.Builder" />
    <Using Include="Microsoft.AspNetCore.Hosting" />
    <Using Include="Microsoft.AspNetCore.Http" />
    <Using Include="Microsoft.AspNetCore.Routing" />
    <Using Include="Microsoft.Extensions.Configuration" />
    <Using Include="Microsoft.Extensions.DependencyInjection" />
    <Using Include="Microsoft.Extensions.Hosting" />
    <Using Include="Microsoft.Extensions.Logging" />
    <!-- The two usings Umbraco.Cms.Targets adds to a web project. -->
    <Using Include="Umbraco.Cms.Core.DependencyInjection" />
    <Using Include="Umbraco.Extensions" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <InternalsVisibleTo Include="UmbracoAppHost.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- Common to every site built on the base; a site gets these transitively. -->
    <PackageReference Include="Umbraco.Cms" />
    <PackageReference Include="AurorisNet.Umbraco.ApplicationVirtualPathFix" />
    <PackageReference Include="AurorisNet.Umbraco.DisableTelemetry" />
    <PackageReference Include="Umbraco.Cms.DevelopmentMode.Backoffice" />
    <PackageReference Include="Umbraco.Community.UmbNav" />
    <PackageReference Include="Umbraco.Community.BlockPreview" />
    <PackageReference Include="Microsoft.Extensions.FileProviders.Embedded" />
    <PackageReference Include="uSync" />
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>

  <ItemGroup>
    <!-- AppBlocks owns forms/data sources; its optional companion supplies interactive reports. -->
    <ProjectReference Include="$(AppBlocksRoot)\src\AppBlocks\AppBlocks.csproj" Condition="'$(UseAppBlocksSource)' == 'true'" />
    <PackageReference Include="AurorisNet.Umbraco.AppBlocks" Condition="'$(UseAppBlocksSource)' != 'true'" />
    <ProjectReference Include="$(AppBlocksRoot)\src\AppBlocks.InteractiveReports\AppBlocks.InteractiveReports.csproj" Condition="'$(UseAppBlocksSource)' == 'true'" />
    <PackageReference Include="AurorisNet.Umbraco.AppBlocks.InteractiveReports" Condition="'$(UseAppBlocksSource)' != 'true'" />
    <ProjectReference Include="$(AppBlocksRoot)\src\AppBlocks.Documents\AppBlocks.Documents.csproj" Condition="'$(UseAppBlocksSource)' == 'true'" />
    <PackageReference Include="AurorisNet.Umbraco.AppBlocks.Documents" Condition="'$(UseAppBlocksSource)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- The configured administrator password and debug sign-in, which register through the package's own composer. -->
    <ProjectReference Include="$(BreakGlassRoot)\src\AurorisNet.Umbraco.BreakGlass.csproj" Condition="'$(UseBreakGlassSource)' == 'true'" />
    <PackageReference Include="AurorisNet.Umbraco.BreakGlass" Condition="'$(UseBreakGlassSource)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Single sign-on, the embedded identity server and the account policy, which AddUmbracoAppHost registers. They
         bring AurorisNet.IdentityServer and the OpenID Connect handler with them. -->
    <ProjectReference Include="$(IdentityServerSsoRoot)\src\AurorisNet.Umbraco.IdentityServer.SSO.csproj" Condition="'$(UseIdentityServerSsoSource)' == 'true'" />
    <PackageReference Include="AurorisNet.Umbraco.IdentityServer.SSO" Condition="'$(UseIdentityServerSsoSource)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <!-- Add from directory for users and members, which registers through the package's own composer. It brings the
         AurorisNet.IdentityServer.Directory people lookup, which the people picker uses too. -->
    <ProjectReference Include="$(IdentityServerDirectoryRoot)\src\AurorisNet.Umbraco.IdentityServer.Directory.csproj" Condition="'$(UseIdentityServerDirectorySource)' == 'true'" />
    <PackageReference Include="AurorisNet.Umbraco.IdentityServer.Directory" Condition="'$(UseIdentityServerDirectorySource)' != 'true'" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="$(InstallRoot)uSync/**/*.config" Link="uSync\%(RecursiveDir)%(Filename)%(Extension)" />
    <Content Include="$(InstallRoot)uSync/**/*.config" Link="uSync\%(RecursiveDir)%(Filename)%(Extension)"
             CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" PackageCopyToOutput="true"
             PackagePath="content/uSync/%(RecursiveDir)%(Filename)%(Extension);contentFiles/any/$(TargetFramework)/uSync/%(RecursiveDir)%(Filename)%(Extension)" />
    <Compile Include="../../Migrations/Runtime/**/*.cs" />
    <EmbeddedResource Include="Hosting\defaults.json" LogicalName="UmbracoAppHost.Hosting.defaults.json" />
    <!-- The sample database's schema scripts, read through the embedded files manifest; see Sample/SampleData.cs. -->
    <EmbeddedResource Include="../../Migrations/**/*.sql" Link="Migrations\%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Views\**\*.cshtml" />
    <EmbeddedResource Include="$(InstallRoot)Schema/ContentTypes/*.config" Link="Schema\ContentTypes\%(Filename)%(Extension)" />
    <Content Remove="wwwroot/dist/**/*" />
    <!-- A published site carries only its own Views folder and editor schema files; the library's
         views are embedded, and every project directory receives its own generated schema copies. -->
    <Content Update="**\*.cshtml" CopyToPublishDirectory="Never" />
    <Content Update="appsettings-schema*.json;umbraco-package-schema.json" CopyToPublishDirectory="Never" CopyToOutputDirectory="Never" Pack="false" />
    <Content Update="Hosting\defaults.json" CopyToPublishDirectory="Never" />
    <!-- The package icon, ready for when the library ships as a NuGet package; the SVG beside it is the editable source. -->
    <None Include="../../docs/images/icon.png" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>

  <!-- Visual Studio only schedules projects listed in its solution. The source dependencies
       stay outside the solution, so build them here using normal project traversal. -->
  <Target Name="BuildSourceDependenciesInVisualStudio" BeforeTargets="ResolveProjectReferences"
          Condition="'$(BuildingInsideVisualStudio)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="@(ProjectReference)" Targets="Build" BuildInParallel="false"
             Properties="Configuration=$(Configuration);BuildingInsideVisualStudio=false;BuildProjectReferences=true"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained" />
  </Target>

  <!-- AppBlocks pins the packages it shares with this library itself so that it builds alone; Directory.Packages.props
       pins them here. A difference would quietly compile AppBlocks against one version and run it on another, so it
       stops the build. The check lives only here, because AppBlocks must not need this repository. -->
  <Target Name="CheckAppBlocksPackageVersions" BeforeTargets="CollectPackageReferences;ResolveProjectReferences"
          Condition="'$(UseAppBlocksSource)' == 'true' and Exists('$(AppBlocksRoot)\src\AppBlocks\AppBlocks.csproj') and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_AppBlocksProject Include="$(AppBlocksRoot)\src\AppBlocks\AppBlocks.csproj;$(AppBlocksRoot)\src\AppBlocks.Documents\AppBlocks.Documents.csproj;$(AppBlocksRoot)\src\AppBlocks.InteractiveReports\AppBlocks.InteractiveReports.csproj" />
    </ItemGroup>
    <!-- Read the evaluated references that NuGet uses, whether a version is literal or comes from a property.
         AppBlocksUmbracoVersion in Directory.Build.props may no longer be used by those references. -->
    <MSBuild Projects="@(_AppBlocksProject)" Targets="CollectPackageReferences"
             Properties="Configuration=$(Configuration)" RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained">
      <Output TaskParameter="TargetOutputs" ItemName="_AppBlocksPackageReference" />
    </MSBuild>
    <PropertyGroup>
      <_AppHostUmbracoVersion>@(PackageVersion->WithMetadataValue('Identity', 'Umbraco.Cms')->Metadata('Version'))</_AppHostUmbracoVersion>
      <_AppHostDevelopmentModeVersion>@(PackageVersion->WithMetadataValue('Identity', 'Umbraco.Cms.DevelopmentMode.Backoffice')->Metadata('Version'))</_AppHostDevelopmentModeVersion>
      <_AppHostSqliteVersion>@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.Data.Sqlite')->Metadata('Version'))</_AppHostSqliteVersion>
      <_AppHostEmbeddedVersion>@(PackageVersion->WithMetadataValue('Identity', 'Microsoft.Extensions.FileProviders.Embedded')->Metadata('Version'))</_AppHostEmbeddedVersion>
      <_AppBlocksUmbracoVersions>@(_AppBlocksPackageReference->WithMetadataValue('Identity', 'Umbraco.Cms')->Metadata('Version')->Distinct())</_AppBlocksUmbracoVersions>
      <_AppBlocksSqliteVersions>@(_AppBlocksPackageReference->WithMetadataValue('Identity', 'Microsoft.Data.Sqlite')->Metadata('Version')->Distinct())</_AppBlocksSqliteVersions>
      <_AppBlocksEmbeddedVersions>@(_AppBlocksPackageReference->WithMetadataValue('Identity', 'Microsoft.Extensions.FileProviders.Embedded')->Metadata('Version')->Distinct())</_AppBlocksEmbeddedVersions>
    </PropertyGroup>
    <Error Condition="'$(_AppBlocksUmbracoVersions)' != '$(_AppHostUmbracoVersion)'"
           Text="Umbraco.Cms is $(_AppHostUmbracoVersion) in UmbracoAppHost's Directory.Packages.props but '$(_AppBlocksUmbracoVersions)' in the AppBlocks projects under $(AppBlocksRoot)\src. Change both together." />
    <Error Condition="'$(_AppHostDevelopmentModeVersion)' != '$(_AppHostUmbracoVersion)'"
           Text="Umbraco.Cms.DevelopmentMode.Backoffice is $(_AppHostDevelopmentModeVersion) but Umbraco.Cms is $(_AppHostUmbracoVersion) in UmbracoAppHost's Directory.Packages.props. Change both together." />
    <!-- AppBlocks stopped pinning Microsoft.Data.Sqlite on 2026-11-01 (it comes with Umbraco.Cms); the check applies only while a project still pins it. -->
    <Error Condition="'$(_AppBlocksSqliteVersions)' != '' and '$(_AppBlocksSqliteVersions)' != '$(_AppHostSqliteVersion)'"
           Text="Microsoft.Data.Sqlite is $(_AppHostSqliteVersion) in UmbracoAppHost's Directory.Packages.props but '$(_AppBlocksSqliteVersions)' in the AppBlocks projects under $(AppBlocksRoot)\src. Change both together." />
    <Error Condition="'$(_AppBlocksEmbeddedVersions)' != '$(_AppHostEmbeddedVersion)'"
           Text="Microsoft.Extensions.FileProviders.Embedded is $(_AppHostEmbeddedVersion) in UmbracoAppHost's Directory.Packages.props but '$(_AppBlocksEmbeddedVersions)' in the AppBlocks projects under $(AppBlocksRoot)\src. Change both together." />
  </Target>

  <Import Project="Frontend.targets" />

  <!-- uSync's package targets disable output copying for this folder. The shared library
       also supplies the export to referencing hosts and the site-management scripts. -->
  <Target Name="IncludeUSyncExport" BeforeTargets="AssignTargetPaths">
    <ItemGroup>
      <Content Condition="$([System.String]::Copy('%(Content.Link)').Replace('\', '/').StartsWith('uSync/'))">
        <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
        <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      </Content>
    </ItemGroup>
  </Target>
</Project>
