  <Info><Name>People picker</Name><Icon>icon-users</Icon><Thumbnail>folder.png</Thumbnail><Description>Find and validate a directory identity inside a form.</Description><AllowAtRoot>False</AllowAtRoot><ListView>00000000-0000-0000-0000-000000000000</ListView><Variations>Nothing</Variations><IsElement>true</IsElement><Folder>AppHost</Folder><Compositions /><DefaultTemplate /><AllowedTemplates /></Info>
