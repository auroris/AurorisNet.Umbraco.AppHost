@using System.Text.Json
@using AppBlocks.Blocks
@using UmbracoAppHost.PeoplePicker
@model AppBlockView
@inject AppPageAssets Assets
@{
    var id = "people-" + Model.Block.ContentKey.ToString("N");
    var settings = PeoplePickerSettings.Read(Model.Block.Content);
    var endpoint = Url.Content($"~/api/people-picker/{Model.Page.Key}/{Model.Block.ContentKey}");
    if (Model.Form?.Culture is { } culture) endpoint += "?appCulture=" + Uri.EscapeDataString(culture);
    var options = JsonSerializer.Serialize(new {
        identityField = settings.IdentityField, nameField = settings.NameField, fieldMappings = settings.FieldMappings,
        prefillMappings = settings.PrefillMappings,
        fallbackFields = settings.FallbackFields, compactUpperFields = settings.CompactUpperFields,
        allowManualEntry = settings.AllowManualEntry, minTermLength = settings.MinTermLength, maxResults = settings.MaxResults,
    });
    Assets.AddStylesheet(Url.Content("~/App_Plugins/PeoplePicker/people-picker.css"));
}
<div id="@id" class="app-people" data-app-account-picker data-block-alias="appPeoplePicker"
    data-popup="@Url.Content("~/App_Plugins/PeoplePicker/people-picker.html")" data-key-parameter="sid" data-endpoint="@endpoint" data-settings="@options">
    <button type="button" data-find title="Search the directory in a new window">@settings.Label</button>
    <button type="button" data-manual hidden>Enter manually</button>
    <span data-status role="status" aria-live="polite"></span>
</div>
<script type="module">
    import { mountPeoplePicker } from '@Url.Content("~/App_Plugins/PeoplePicker/people-picker.js")';
    const picker = document.getElementById('@id');
    if (picker && !picker.closest('dialog[data-app-form-panel]')) mountPeoplePicker(picker);
</script>
