@inherits UmbracoViewPage
@inject AppBlocks.Blocks.AppPageAccess PageAccess
@{
    var items = await SiteMenu.BuildAuthoredAsync(Model, NavigationQueryService, PublishedStatusFilteringService);
    var site = Model.SiteRoot(NavigationQueryService, PublishedStatusFilteringService);
}
@* The site's authored menu; without one, the site and the pages directly beneath it. *@
<ul class="site-menu">
    @if (items is not null)
    {
        <partial name="Website/MenuItems" model="items" />
    }
    else
    {
        var candidates = site.VisibleChildren(NavigationQueryService, PublishedStatusFilteringService).Prepend(site);
        foreach (var entry in await PageAccess.NavigationPagesAsync(candidates))
        {
            <li><a href="@entry.NavigationUrl()" aria-current="@(entry.Key == Model.Key ? "page" : null)">@entry.NavigationTitle()</a></li>
        }
    }
    <li class="site-languages"><partial name="Website/LanguageSelector" /></li>
</ul>
