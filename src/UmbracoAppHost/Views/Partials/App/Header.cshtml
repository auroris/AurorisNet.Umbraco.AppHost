@inherits UmbracoViewPage
@{
    var application = Model.SiteRoot(NavigationQueryService, PublishedStatusFilteringService);
    var menu = await SiteMenu.BuildAuthoredAsync(Model, NavigationQueryService, PublishedStatusFilteringService, "accountMenu");
}
<header class="app-header">
    <button type="button" class="app-nav-toggle" aria-controls="app-nav" aria-expanded="true" aria-label="Menu" title="Menu"><span></span></button>
    <a class="app-brand" href="@application.Url()">@application.NavigationTitle()</a>
    <div class="app-user">
        @if (menu is { Count: > 0 } && Visitor.IsMember)
        {
            <details class="app-account">
                <summary class="app-account-toggle">
                    <span class="app-user-name">@Visitor.Name</span>
                </summary>
                <ul class="app-account-menu"><partial name="App/NavigationMenuItems" model="menu" /></ul>
            </details>
        }
        else if (menu is { Count: > 0 })
        {
            <ul class="app-account-links"><partial name="App/NavigationMenuItems" model="menu" /></ul>
        }
    </div>
</header>
