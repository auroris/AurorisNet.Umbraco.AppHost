<Project>
  <PropertyGroup>
    <AppBlocksRoot Condition="'$(AppBlocksRoot)' == ''">$([MSBuild]::NormalizePath('$(MSBuildThisFileDirectory)', '..', 'AurorisNet.Umbraco.AppBlocks'))</AppBlocksRoot>
  </PropertyGroup>
  <!-- Package metadata for the two packages this repository ships: AurorisNet.Umbraco.AppHost and
       AurorisNet.Umbraco.AppHost.Testing. They always carry the same version, because the testing package
       applies the host's registrations by reflection. The other projects build exactly as before. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'UmbracoAppHost' or '$(MSBuildProjectName)' == 'UmbracoAppHost.Testing'">
    <Version>1.0.0-alpha.1</Version>
    <Authors>auroris</Authors>
    <PackageProjectUrl>https://github.com/auroris/AurorisNet.Umbraco.AppHost</PackageProjectUrl>
    <RepositoryUrl>https://github.com/auroris/AurorisNet.Umbraco.AppHost</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'UmbracoAppHost' or '$(MSBuildProjectName)' == 'UmbracoAppHost.Testing'">
    <None Include="$(MSBuildThisFileDirectory)LICENSE" Pack="true" PackagePath="/" Visible="false" />
  </ItemGroup>
</Project>
